{
  "name": "nicely-neon-theme",
  "displayName": "Nicely Neon Theme",
  "description": "A vivid, carefully balanced dark theme for Visual Studio Code and Cursor.",
  "version": "2.1.0",
  "publisher": "eight84",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "neon",
    "colorful",
    "vibrant",
    "high contrast",
    "cursor"
  ],
  "scripts": {
    "check": "node scripts/validate-theme.mjs",
    "package:vsix": "npx --yes @vscode/vsce package"
  },
  "contributes": {
    "themes": [
      {
        "label": "Nicely Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/nicely-neon-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eight84/nicely-neon-theme.git"
  },
  "bugs": {
    "url": "https://github.com/eight84/nicely-neon-theme/issues"
  },
  "homepage": "https://nicely-neon-theme.netlify.app",
  "license": "MIT",
  "icon": "img/icon.png"
}
